# PostgreSQL connection string (docker compose exposes the DB on port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/splitpal

# Secret used to sign session cookies (at least 32 characters).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-32chars

# Used for "today" and month boundaries
APP_TIMEZONE=Asia/Bangkok
